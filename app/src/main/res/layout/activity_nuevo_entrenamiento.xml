<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fittrack_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp">

            <!-- CABECERA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/fittrack_chip_bg"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@null"
                    app:elevation="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="NUEVO ENTRENAMIENTO"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- SELECTOR DE DEPORTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deporte"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/chipCarrera"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Carrera/Andar"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/fittrack_chip_bg"
                    app:cornerRadius="20dp"
                    app:elevation="0dp" />

                <Button
                    android:id="@+id/chipCiclismo"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Ciclismo"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/fittrack_chip_bg"
                    app:cornerRadius="20dp"
                    app:elevation="0dp" />

                <Button
                    android:id="@+id/chipNatacion"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Natación"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/fittrack_chip_bg"
                    app:cornerRadius="20dp"
                    app:elevation="0dp" />
            </LinearLayout>

            <!-- ===================== PANEL CARRERA/ANDAR ===================== -->
            <LinearLayout
                android:id="@+id/groupCarrera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/cardCronometroCarrera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvEstadoCarrera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LISTO PARA EMPEZAR"
                        android:textColor="@color/fittrack_text_gray"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvTiempoCarrera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="40sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout style="@style/EstadisticaCard">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="DISTANCIA" />
                        <TextView android:id="@+id/tvDistanciaCarrera" style="@style/EstadisticaValor" android:text="0,00 km" />
                    </LinearLayout>

                    <LinearLayout style="@style/EstadisticaCardIntermedia">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="PASOS" />
                        <TextView android:id="@+id/tvPasosCarrera" style="@style/EstadisticaValor" android:text="0" />
                    </LinearLayout>

                    <LinearLayout style="@style/EstadisticaCardFinal">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="RITMO" />
                        <TextView android:id="@+id/tvRitmoCarrera" style="@style/EstadisticaValor" android:text="--:--" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <LinearLayout style="@style/EstadisticaCard">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="VEL. MEDIA" />
                        <TextView android:id="@+id/tvVelMediaCarrera" style="@style/EstadisticaValor" android:text="0,0 km/h" />
                    </LinearLayout>

                    <LinearLayout style="@style/EstadisticaCardFinal">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="DESNIVEL" />
                        <TextView android:id="@+id/tvDesnivelCarrera" style="@style/EstadisticaValor" android:text="0 m" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnIniciarCarrera"
                    style="@style/BotonCronometroIniciar"
                    android:text="Iniciar" />

                <LinearLayout
                    android:id="@+id/rowPausarFinalizarCarrera"
                    style="@style/FilaPausarFinalizar">

                    <Button android:id="@+id/btnPausarCarrera" style="@style/BotonPausar" android:text="Pausar" />
                    <Button android:id="@+id/btnFinalizarCarrera" style="@style/BotonFinalizar" android:text="Finalizar" />
                </LinearLayout>

                <include layout="@layout/bloque_fc_manual"
                    android:id="@+id/fcManualCarrera" />
            </LinearLayout>

            <!-- ===================== PANEL CICLISMO ===================== -->
            <LinearLayout
                android:id="@+id/groupCiclismo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/cardCronometroCiclismo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvEstadoCiclismo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LISTO PARA EMPEZAR"
                        android:textColor="@color/fittrack_text_gray"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvTiempoCiclismo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="40sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout style="@style/EstadisticaCard">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="DISTANCIA" />
                        <TextView android:id="@+id/tvDistanciaCiclismo" style="@style/EstadisticaValor" android:text="0,00 km" />
                    </LinearLayout>

                    <LinearLayout style="@style/EstadisticaCardFinal">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="VEL. MEDIA" />
                        <TextView android:id="@+id/tvVelMediaCiclismo" style="@style/EstadisticaValor" android:text="0,0 km/h" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <LinearLayout style="@style/EstadisticaCard">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="VEL. MÁXIMA" />
                        <TextView android:id="@+id/tvVelMaximaCiclismo" style="@style/EstadisticaValor" android:text="0,0 km/h" />
                    </LinearLayout>

                    <LinearLayout style="@style/EstadisticaCardFinal">
                        <TextView style="@style/EstadisticaEtiqueta" android:text="DESNIVEL" />
                        <TextView android:id="@+id/tvDesnivelCiclismo" style="@style/EstadisticaValor" android:text="0 m" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnIniciarCiclismo"
                    style="@style/BotonCronometroIniciar"
                    android:text="Iniciar" />

                <LinearLayout
                    android:id="@+id/rowPausarFinalizarCiclismo"
                    style="@style/FilaPausarFinalizar">

                    <Button android:id="@+id/btnPausarCiclismo" style="@style/BotonPausar" android:text="Pausar" />
                    <Button android:id="@+id/btnFinalizarCiclismo" style="@style/BotonFinalizar" android:text="Finalizar" />
                </LinearLayout>

                <include layout="@layout/bloque_fc_manual"
                    android:id="@+id/fcManualCiclismo" />
            </LinearLayout>

            <!-- ===================== PANEL NATACION ===================== -->
            <LinearLayout
                android:id="@+id/groupNatacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/cardCronometroNatacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tvEstadoNatacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LISTO PARA EMPEZAR"
                        android:textColor="@color/fittrack_text_gray"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvTiempoNatacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="40sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnIniciarNatacion"
                    style="@style/BotonCronometroIniciar"
                    android:text="Iniciar" />

                <LinearLayout
                    android:id="@+id/rowPausarFinalizarNatacion"
                    style="@style/FilaPausarFinalizar">

                    <Button android:id="@+id/btnPausarNatacion" style="@style/BotonPausar" android:text="Pausar" />
                    <Button android:id="@+id/btnFinalizarNatacion" style="@style/BotonFinalizar" android:text="Finalizar" />
                </LinearLayout>

                <!-- ESTILO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estilo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <Button android:id="@+id/chipLibreNatacion" style="@style/ChipEstilo" android:text="Libre" />
                    <Button android:id="@+id/chipEspaldaNatacion" style="@style/ChipEstiloIntermedio" android:text="Espalda" />
                    <Button android:id="@+id/chipBrazaNatacion" style="@style/ChipEstiloIntermedio" android:text="Braza" />
                    <Button android:id="@+id/chipMariposaNatacion" style="@style/ChipEstiloFinal" android:text="Mariposa" />
                </LinearLayout>

                <!-- LARGOS Y LONGITUD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView style="@style/CampoEtiqueta" android:text="LARGOS" />
                        <EditText
                            android:id="@+id/etLargosNatacion"
                            style="@style/CampoInput"
                            android:hint="40"
                            android:inputType="number" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/CampoEtiqueta" android:text="LONGITUD PISCINA (m)" />
                        <EditText
                            android:id="@+id/etLongitudPiscinaNatacion"
                            style="@style/CampoInput"
                            android:hint="25"
                            android:inputType="numberDecimal" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDistanciaCalculadaNatacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:padding="14dp"
                    android:text="Distancia: 0 m"
                    android:textColor="@color/fittrack_text_gray"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- SWOLF OPCIONAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <TextView style="@style/CampoEtiqueta" android:text="SWOLF (opcional)" />
                    <EditText
                        android:id="@+id/etSwolfNatacion"
                        style="@style/CampoInput"
                        android:hint="Ej. 38" />
                </LinearLayout>

                <include layout="@layout/bloque_fc_manual"
                    android:id="@+id/fcManualNatacion" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGuardarEntrenamiento"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        android:text="Guardar entrenamiento"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/fittrack_red"
        app:cornerRadius="12dp"
        app:elevation="4dp" />

</FrameLayout>